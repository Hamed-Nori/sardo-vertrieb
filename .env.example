# Kopieren nach .env.local – niemals mit NEXT_PUBLIC_ prefixen (nur serverseitig).
# Hier KEINE echten Werte eintragen: Diese Datei wird eingecheckt.
# Nach Änderungen neu bauen: Ob das Formular versendet, wird beim Build festgelegt.

# Mailversand (Resend, EU-Region). Erst wenn beide gesetzt sind, wird versendet.
RESEND_API_KEY=
CONTACT_TO=
# Absender mit bei Resend verifizierter Domain, z. B. "Sardo Digital <kontakt@example.de>"
CONTACT_FROM=

# Produktionsdomain (Canonical, Sitemap, Open Graph)
SITE_URL=
# Erst nach Freigabe von Impressum, Datenschutz und Konditionen auf true setzen
SITE_INDEXABLE=false
